[Unit]
Description=HandyOS verified app-only release (outbound)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/HandyOS
ExecStart=/usr/bin/python3 /home/ubuntu/HandyOS/deploy/internal/poll-release.py --deploy
TimeoutStartSec=16min
NoNewPrivileges=true
